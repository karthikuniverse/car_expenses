# ==============================================================================
# Car Expenses Backend - Environment Variables Example
# Copy this file to .env for local development or .env.production for production
# ==============================================================================

# Server Port (Frontend defaults to communicating with port 5000)
PORT=5000

# Environment Mode: development | production
NODE_ENV=development

# MongoDB Connection URI:
# - Local MongoDB: mongodb://127.0.0.1:27017/car_expenses
# - Production (MongoDB Atlas): mongodb+srv://<user>:<password>@cluster0.mongodb.net/car_expenses?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/car_expenses

# JWT Secret and Expiration Token
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d
