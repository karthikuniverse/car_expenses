# ==============================================================================
# Car Expenses Backend - Production Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Production Database / MongoDB Atlas)
# Replace <username>, <password>, and <cluster-url> with your production credentials
# Example:
# MONGODB_URI=mongodb+srv://admin:secure_password@cluster0.mongodb.net/car_expenses?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/car_expenses?retryWrites=true&w=majority

# JWT Authentication Configuration
# Set a strong, randomly generated 64-character secret in production
JWT_SECRET=replace_with_a_secure_random_64_char_production_secret
JWT_EXPIRE=30d
